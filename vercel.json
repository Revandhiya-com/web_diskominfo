{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": [
        "admin/**",
        "config/**",
        "database/**",
        "helpers/**",
        "includes/**",
        "pages/**",
        "assets/**",
        "uploads/**"
      ]
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.php" }
  ]
}
