# Kredensial database: file ini AMAN di-commit karena hanya berisi
# konfigurasi env-aware (tidak ada secret produksi — rahasia diambil dari
# environment variable Vercel/Supabase). JANGAN commit file .env atau dump.
config/database.php.example

# Konten upload pengguna
uploads/news/*
uploads/albums/*
uploads/documents/*
uploads/videos/*
uploads/alumni/*
uploads/karya/*
uploads/photos/*
uploads/avatars/*

# Log aplikasi
logs/*
!logs/.htaccess

# Hasil backup lokal (jangan di-commit)
backup/

# File sistem/editor
Thumbs.db
.DS_Store
*.log

# Artefak sesi/dump internal yang tidak boleh ikut versi
session-ses_*.md
.vercel
